---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/base.astro";
import Navbar from "../../components/navbar.astro";
import Search from "../../components/islands/search.jsx";
import { formatArticleDate, sortArticlesByDate } from "../../lib/articles.js";

const dictionary = await getCollection("dictionary");
const articles = sortArticlesByDate(await getCollection("articles"));
---

<BaseLayout
  pageTitle="Articles"
  description="Explore articles about software engineering and technology on jargons.dev."
  class="min-h-screen"
>
  <Navbar returnNav={{ label: "Back to Dictionary", location: "/" }}>
    <Search triggerSize="sm" dictionary={dictionary} client:load />
  </Navbar>

  <main class="max-w-screen-lg mx-auto px-5 pb-20 pt-10 md:pt-16">
    <header class="border-b border-black pb-7 md:pb-10">
      <p class="font-mono text-xs font-semibold uppercase text-gray-500">
        Jargons.dev / Library
      </p>
      <h1 class="mt-4 text-4xl font-black md:text-6xl">Articles</h1>
      <p
        class="mt-4 max-w-xl text-base leading-relaxed text-gray-600 md:text-lg"
      >
        Ideas, explanations, and guides for the curious developer.
      </p>
    </header>

    {
      articles.length === 0 ? (
        <p class="py-12 text-gray-600">No articles have been published yet.</p>
      ) : (
        <ol class="divide-y divide-gray-200">
          {articles.map((article) => (
            <li class="py-7 md:py-9">
              <article class="grid gap-5 sm:grid-cols-[minmax(0,1fr)_12rem] md:grid-cols-[minmax(0,1fr)_15rem] md:gap-10">
                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-gray-500">
                    <time datetime={article.data.publishedAt.toISOString()}>
                      {formatArticleDate(article.data.publishedAt)}
                    </time>
                    <span aria-hidden="true">/</span>
                    <span>
                      {article.data.author.name || article.data.author.github}
                    </span>
                  </div>
                  <h2 class="mt-3 text-xl font-bold leading-snug md:text-2xl">
                    <a
                      href={`/articles/${encodeURIComponent(article.id)}`}
                      class="text-black no-underline hover:underline"
                    >
                      {article.data.title}
                    </a>
                  </h2>
                  <p class="mt-3 max-w-2xl text-sm leading-6 text-gray-600 md:text-base">
                    {article.data.description}
                  </p>
                  {article.data.tags.length > 0 && (
                    <p class="mt-4 font-mono text-xs text-gray-500">
                      {article.data.tags.join(" / ")}
                    </p>
                  )}
                </div>
                <a
                  href={`/articles/${encodeURIComponent(article.id)}`}
                  tabindex="-1"
                  aria-hidden="true"
                  class="order-first block sm:order-last"
                >
                  <img
                    src={article.data.cover.url}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="aspect-[16/9] w-full rounded object-cover bg-gray-100"
                  />
                </a>
              </article>
            </li>
          ))}
        </ol>
      )
    }
  </main>
</BaseLayout>
